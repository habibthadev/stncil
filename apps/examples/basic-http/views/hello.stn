<div class="page-header"><div><h1>Hello, {{ name }}.</h1><p>{{ greeting }}</p></div></div>
<section class="section" aria-labelledby="about-heading"><h2 id="about-heading">Your greeting</h2><div class="info-box"><p>The name <strong>{{ name }}</strong> came from the URL. stncil escapes it before rendering this page.</p></div></section>
<section class="section" aria-labelledby="request-heading"><h2 id="request-heading">The request</h2><table><thead><tr><th scope="col">Field</th><th scope="col">Value</th></tr></thead><tbody><tr><th scope="row">Method</th><td><code>{{ method }}</code></td></tr><tr><th scope="row">URL</th><td><code>{{ url }}</code></td></tr><tr><th scope="row">Time</th><td><code>{{ now | date_format("HH:mm") }}</code></td></tr></tbody></table></section>
<div class="actions"><a href="/" class="btn btn-ghost">Back to home</a><a href="/hello?name=stncil" class="btn btn-primary">Greet stncil</a></div>
