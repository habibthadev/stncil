<div class="page-header"><div><h1>Templates with a voice.</h1><p>{{ tagline }}</p></div></div>
<section class="section" aria-labelledby="posts-heading">
  <div class="section-header"><h2 id="posts-heading">From the notebook</h2><span class="badge">{{ posts.length }} posts</span></div>
  @if (posts && posts.length > 0) {
    @each (post in posts) {
      <article class="post-item"><div class="post-heading"><h3>{{ post.title }}</h3><span class="author">{{ post.author }}</span></div><p class="meta">{{ post.date | date_format("MMM DD, YYYY") }}</p><p class="excerpt">{{ post.excerpt }}</p><div class="actions"><a href='/hello?name={{ post.author | url_encode }}' class="btn btn-ghost">Say hello <svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></a></div></article>
    }
  } @else { <div class="empty-state"><p>No posts yet.</p></div> }
</section>
<section class="section" aria-labelledby="server-heading"><h2 id="server-heading">The server</h2><dl class="info-grid"><div><dt>Posts rendered</dt><dd>{{ posts.length }}</dd></div><div><dt>Started</dt><dd>{{ started_at | date_format("MMM DD, HH:mm") }}</dd></div></dl></section>
