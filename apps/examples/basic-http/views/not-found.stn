<div style="padding-top: 1rem;">
  <div class="error-code">404</div>
  <h1>Page Not Found</h1>
  <p style="color: var(--muted); margin-top: 0.75rem;">The path <code>{{ path }}</code> does not exist.</p>
  <p style="color: var(--muted); font-size: 0.875rem; margin-top: 0.25rem;">Check the URL or navigate using the links above.</p>
  <div style="margin-top: 2rem;">
    <a href="/" class="btn"><i data-lucide='arrow-left' style="width: 14px; height: 14px; stroke-width: 2;"></i> Back to Home</a>
  </div>
</div>
