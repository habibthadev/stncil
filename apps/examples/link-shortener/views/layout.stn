<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="{{ csrf_token }}" />
  <title>{{ title }} / stncil</title>
  <meta name="description" content="{{ description }}" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23191919'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-size='44' font-family='monospace' fill='white'%3E%40%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Sora:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/design.css" />
  <link rel="stylesheet" href="/main.css" />
  <script src="/app.js" defer></script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header">
    <nav class="nav" aria-label="Main navigation">
      <a href="/" class="brand" aria-label="stncil links home"><span class="brand-sigil" aria-hidden="true">&#64;</span><span>stncil</span></a>
      <span class="nav-divider" aria-hidden="true">/</span>
      <a href="/" class="nav-current">Links</a>
      <div class="nav-actions">
        <a href="https://github.com/habibthadev/stncil" class="source-link" target="_blank" rel="noopener noreferrer">Source code <svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></a>
        <button class="btn-icon" id="theme-toggle" aria-label="Switch to dark theme" aria-pressed="false"><svg class="icon" aria-hidden="true" id="theme-icon"><use href="/icons.svg#moon"></use></svg></button>
      </div>
    </nav>
  </header>
  <main id="main" class="container" tabindex="-1">
    {{{ content }}}
  </main>
  <footer class="footer"><span>Made with <a href="https://github.com/habibthadev/stncil">stncil</a></span><span>A template language of its own.</span></footer>
  <dialog id="delete-dialog" class="dialog" aria-labelledby="delete-dialog-title" aria-describedby="delete-dialog-description">
    <h2 id="delete-dialog-title">Delete this link?</h2>
    <p id="delete-dialog-description">The short URL will stop working. This cannot be undone.</p>
    <p id="delete-link-label" class="dialog-link"></p>
    <div class="dialog-actions"><button class="btn btn-ghost" id="dialog-cancel" autofocus>Keep link</button><button class="btn btn-danger" id="dialog-confirm">Delete link</button></div>
  </dialog>
  <div id="toast-container" class="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>
</body>
</html>
