<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta charset="UTF-8" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Sora:wght@500&display=swap" rel="stylesheet" />

  <title>{{ subject }}</title>
  <style>strong { font-weight: 500; } p, h1, h2, td { overflow-wrap: anywhere; } a { word-break: break-word; }</style>
</head>
<body style="margin: 0; padding: 0; background: #f6f6f5; font-family: 'Instrument Sans', system-ui, -apple-system, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding: 24px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; max-width: 480px; background: #fff; border: 1px solid #e6e6e4; border-radius: 12px; overflow: hidden;">
          <tr>
            <td style="padding: 24px; border-bottom: 1px solid #e6e6e4;">
              <span style="font-size: 12px; color: #646464;">{{ type | upper }} &middot; {{ timestamp | date_format("MMM DD, HH:mm") }}</span>
              <h2 style="font-family: 'Sora', system-ui, sans-serif; font-weight: 500; margin: 8px 0 0; font-size: 18px; color: #191919;">{{ subject }}</h2>
            </td>
          </tr>
          <tr>
            <td style="padding: 24px;">
              <p style="margin: 0 0 16px; color: #191919; font-size: 14px; line-height: 1.6;">{{ message }}</p>

              @if (details && details.length > 0) {
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 16px 0;">
                  @each (detail, index in details) {
                    <tr>
                      <td style="padding: 8px 12px; @if (index > 0) { border-top: 1px solid #e6e6e4; } color: #191919; font-size: 13px;">
                        <span style="color: #646464;">{{ detail.label }}</span>
                        <span style="float: right; color: #191919; font-weight: 500;">{{ detail.value }}</span>
                      </td>
                    </tr>
                  }
                </table>
              }

              @if (action_url && action_label) {
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top: 16px;">
                  <tr>
                    <td align="center" style="background: #191919; border-radius: 6px; padding: 10px 20px;">
                      <a href='{{ action_url | url }}' style="color: #fff; text-decoration: none; font-size: 13px; font-weight: 500;">{{ action_label }}</a>
                    </td>
                  </tr>
                </table>
              }
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
