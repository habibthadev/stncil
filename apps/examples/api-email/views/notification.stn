<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 0; background: #f4f4f5; font-family: -apple-system, system-ui, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding: 24px 0;">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background: #fff; border-radius: 8px; overflow: hidden;">
          <tr>
            <td style="padding: 24px; border-bottom: 1px solid #e2e8f0;">
              <span style="font-size: 12px; color: #64748b;">{{ type | upper }} &middot; {{ timestamp | date_format("MMM DD, HH:mm") }}</span>
              <h2 style="margin: 8px 0 0; font-size: 18px; color: #0f172a;">{{ subject }}</h2>
            </td>
          </tr>
          <tr>
            <td style="padding: 24px;">
              <p style="margin: 0 0 16px; color: #334155; font-size: 14px; line-height: 1.6;">{{ message }}</p>

              @if (details && details.length > 0) {
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 16px 0;">
                  @each (detail in details) {
                    <tr>
                      <td style="padding: 8px 12px; @if (detail != details[0]) { border-top: 1px solid #f1f5f9; } color: #475569; font-size: 13px;">
                        <span style="color: #94a3b8;">{{ detail.label }}</span>
                        <span style="float: right; color: #0f172a; font-weight: 500;">{{ detail.value }}</span>
                      </td>
                    </tr>
                  }
                </table>
              }

              @if (action_url && action_label) {
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top: 16px;">
                  <tr>
                    <td align="center" style="background: #2563eb; border-radius: 6px; padding: 10px 20px;">
                      <a href='{{ action_url }}' style="color: #fff; text-decoration: none; font-size: 13px; font-weight: 600;">{{ action_label }}</a>
                    </td>
                  </tr>
                </table>
              }
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
