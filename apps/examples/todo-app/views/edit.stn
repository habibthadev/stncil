<a href="/" class="back-link"><svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-left"></use></svg> Back to tasks</a>
@if (todo) {
  <div class="page-header"><div><h1>Edit task</h1><p>Make the next step a little clearer.</p></div></div>
  <form method="POST" action='/todos/{{ todo.id }}/update' class="edit-form">@csrf<div class="field"><label for="title">Task</label><input type="text" id="title" name="title" value="{{ todo.title }}" maxlength="240" required /></div><div class="actions"><button type="submit" class="btn btn-primary">Save changes</button><a href="/" class="btn btn-ghost">Cancel</a></div></form>
} @else { <div class="empty-state"><h1>Task not found</h1><p>It may have been deleted. Choose another from your list.</p></div> }
