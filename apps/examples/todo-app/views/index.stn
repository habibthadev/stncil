<div class="page-header"><div><h1>A little less on your mind.</h1><p>A place for the things you want to get done.</p></div></div>
@if (message) { <div class="alert" role="alert">{{ message }}</div> }
<form method="POST" action="/todos" class="todo-form">
  @csrf
  <div class="field"><label for="task-title">New task</label><input type="text" id="task-title" name="title" maxlength="240" placeholder="What needs doing?" required /></div>
  <button type="submit" class="btn btn-primary">Add task <svg class="icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg></button>
</form>
<nav class="todo-filters" aria-label="Filter tasks">
  <a href="/" class='filter @if (currentFilter == "all") { active }' @if (currentFilter == "all") { aria-current="page" }>All <span>{{ counts.all }}</span></a>
  <a href="/?filter=active" class='filter @if (currentFilter == "active") { active }' @if (currentFilter == "active") { aria-current="page" }>Active <span>{{ counts.active }}</span></a>
  <a href="/?filter=completed" class='filter @if (currentFilter == "completed") { active }' @if (currentFilter == "completed") { aria-current="page" }>Done <span>{{ counts.completed }}</span></a>
</nav>
@if (todos && todos.length > 0) {
  <ul class="todo-list">
    @each (todo in todos) {
      <li class="todo-item">
        <form method="POST" action='/todos/{{ todo.id }}/toggle'>@csrf<button type="submit" class='todo-check @if (todo.completed) { completed }' aria-label="Toggle completion for {{ todo.title }}" aria-pressed="{{ todo.completed }}"><svg class="icon" aria-hidden="true"><use href="/icons.svg#{{ todo.completed ? 'check' : 'minus' }}"></use></svg></button></form>
        <div class="todo-body"><span class='todo-title @if (todo.completed) { completed }'>{{ todo.title }}</span><span class="todo-meta">{{ todo.createdAt | date_format("MMM DD") }}</span></div>
        <div class="todo-actions"><a href='/todos/{{ todo.id }}/edit' class="btn-icon" aria-label="Edit {{ todo.title }}"><svg class="icon" aria-hidden="true"><use href="/icons.svg#pencil"></use></svg></a><form method="POST" action='/todos/{{ todo.id }}/delete' data-delete-task="{{ todo.title }}">@csrf<button type="submit" class="btn-icon danger" aria-label="Delete {{ todo.title }}"><svg class="icon" aria-hidden="true"><use href="/icons.svg#trash-2"></use></svg></button></form></div>
      </li>
    }
  </ul>
} @else { <div class="empty-state">@if (currentFilter == "active") { <h2>Nothing left on the list</h2><p><a href="/?filter=completed">View completed tasks</a></p> } @else if (currentFilter == "completed") { <h2>No completed tasks yet</h2><p>Check off a task to see it here.</p> } @else { <h2>Your list starts here</h2><p>Add a task above.</p> }</div> }
