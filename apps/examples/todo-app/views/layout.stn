<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} &mdash; Tasks</title>
  <meta name="description" content='{{ description }}' />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.468.0/dist/umd/lucide.min.js" crossorigin="anonymous"></script>
  @style {
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --paper: #f7f5f0;
      --ink: #1c1917;
      --ink-light: #292524;
      --muted: #8a7f7a;
      --border: #e5ddd5;
      --accent: #d4593a;
      --accent-hover: #b8462e;
      --teal: #2d6a5e;
      --surface: #ffffff;
      --code-bg: #eae5dd;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
      background: var(--paper);
      color: var(--ink);
      line-height: 1.5;
      min-height: 100dvh;
    }

    h1, h2, h3 {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    h1 { font-size: 1.75rem; font-weight: 700; line-height: 1.1; }

    .skip-link {
      position: absolute; top: -100%; left: 1rem;
      background: var(--ink); color: var(--paper);
      padding: 0.5rem 1rem;
      z-index: 100; text-decoration: none; font-size: 0.875rem;
    }

    .skip-link:focus { top: 0; }

    nav {
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      display: flex;
      gap: 1.5rem;
      align-items: stretch;
      height: 52px;
      background: var(--surface);
    }

    nav a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.8125rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: color 0.15s, border-color 0.15s;
    }

    nav a:hover { color: var(--ink); }

    nav .brand {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 0.9375rem;
      color: var(--ink);
      margin-right: auto;
      display: flex;
      align-items: center;
      letter-spacing: -0.01em;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    .page-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 28px;
      height: 28px;
      padding: 0 0.5rem;
      font-size: 0.8125rem;
      font-weight: 600;
      background: var(--border);
      color: var(--muted);
      font-family: 'DM Sans', sans-serif;
    }

    .todo-form {
      display: flex;
      gap: 0.75rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0;
    }

    .todo-form input {
      flex: 1;
      border: 1px solid var(--border);
      background: var(--surface);
      padding: 0.625rem 0.875rem;
      font-size: 0.9375rem;
      color: var(--ink);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: border-color 0.15s;
    }

    .todo-form input:focus {
      border-color: var(--accent);
    }

    .todo-form input::placeholder {
      color: var(--muted);
    }

    .todo-filters {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border);
    }

    .todo-filters .filter {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--muted);
      text-decoration: none;
      padding: 0.625rem 1rem 0.625rem 0;
      transition: color 0.15s;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .todo-filters .filter:hover {
      color: var(--ink-light);
    }

    .todo-filters .filter.active {
      color: var(--ink);
    }

    .todo-list {
      border-top: 1px solid var(--border);
    }

    .todo-item {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0.75rem;
      align-items: center;
      padding: 0.875rem 0;
      border-bottom: 1px solid var(--border);
      transition: opacity 0.15s;
    }

    .todo-item:last-of-type {
      border-bottom: none;
    }

    .todo-check {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: none;
      border: 1px solid var(--border);
      cursor: pointer;
      color: var(--muted);
      transition: color 0.15s, border-color 0.15s, background 0.15s;
      padding: 0;
      flex-shrink: 0;
    }

    .todo-check:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .todo-check.completed {
      border-color: var(--teal);
      background: var(--teal);
      color: var(--surface);
    }

    .todo-check.completed:hover {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--surface);
    }

    .todo-body {
      display: grid;
      gap: 0.125rem;
      min-width: 0;
    }

    .todo-title {
      font-size: 0.9375rem;
      color: var(--ink);
      line-height: 1.4;
      word-break: break-word;
    }

    .todo-title.completed {
      color: var(--muted);
      text-decoration: line-through;
    }

    .todo-meta {
      font-size: 0.6875rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .todo-actions {
      display: flex;
      gap: 0.125rem;
      flex-shrink: 0;
    }

    .todo-actions button,
    .todo-actions a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--muted);
      transition: color 0.15s;
      text-decoration: none;
    }

    .todo-actions .edit-btn:hover { color: var(--accent); }
    .todo-actions .delete-btn:hover { color: #b8462e; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      background: var(--ink);
      color: var(--surface);
      padding: 0.5rem 1rem;
      text-decoration: none;
      font-size: 0.8125rem;
      font-weight: 500;
      transition: background 0.15s;
      border: none;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      white-space: nowrap;
    }

    .btn:hover { background: var(--accent); }
    .btn-sm { padding: 0.5rem 0.875rem; font-size: 0.8125rem; }

    .empty-state {
      padding: 3rem 0;
      text-align: center;
    }

    .empty-state p {
      font-size: 0.9375rem;
      color: var(--muted);
    }

    .empty-state .sub {
      font-size: 0.8125rem;
      color: var(--muted);
      margin-top: 0.25rem;
    }

    .alert {
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      margin-bottom: 1.25rem;
      border: 1px solid var(--accent);
      color: var(--accent-hover);
      background: var(--surface);
    }

    .edit-form {
      max-width: 480px;
    }

    .edit-form .field {
      display: grid;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .edit-form label {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--ink);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .edit-form input {
      border: 1px solid var(--border);
      background: var(--surface);
      padding: 0.625rem 0.875rem;
      font-size: 0.9375rem;
      color: var(--ink);
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: border-color 0.15s;
    }

    .edit-form input:focus {
      border-color: var(--accent);
    }

    .edit-form .actions {
      display: flex;
      gap: 0.75rem;
    }

    code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8125rem;
      background: var(--code-bg);
      padding: 0.125rem 0.375rem;
    }

    footer {
      color: var(--muted);
      font-size: 0.75rem;
      padding: 2rem 1.5rem 3rem;
      border-top: 1px solid var(--border);
      max-width: 600px;
      margin: 0 auto;
      text-align: center;
    }
  }
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <nav>
    <span class="brand">Tasks</span>
    <a href="/">All</a>
  </nav>

  <main id="main" class="container">
    {{{ content }}}
  </main>

  <footer>
    <p>Stncil &middot; {{ year }}</p>
  </footer>
  <script>lucide.createIcons()</script>
</body>
</html>
