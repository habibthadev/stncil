<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} / stncil</title>
  <meta name="description" content="{{ description }}" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23191919'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-size='44' font-family='monospace' fill='white'%3E%40%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Sora:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/design.css" />
  <script src="/tasks.js" defer></script>
</head>
<body class="layout-narrow">
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header"><nav class="nav" aria-label="Main navigation"><a href="/" class="brand"><span class="brand-sigil" aria-hidden="true">&#64;</span> stncil</a><span class="nav-divider" aria-hidden="true">/</span><span class="nav-current">Tasks</span><div class="nav-actions"><a href="/" class="nav-current">Home</a></div></nav></header>
  <main id="main" class="container" tabindex="-1">{{{ content }}}</main>
  <footer class="footer"><span>Made with stncil</span><span>In-memory demo. Restarting restores the sample tasks.</span></footer>
  <dialog id="task-delete-dialog" class="dialog" aria-labelledby="task-delete-heading"><h2 id="task-delete-heading">Delete this task?</h2><p id="task-delete-label" class="dialog-link"></p><div class="dialog-actions"><button id="task-keep" class="btn btn-ghost" autofocus>Keep task</button><button id="task-delete" class="btn btn-danger">Delete task</button></div></dialog>
</body>
</html>
