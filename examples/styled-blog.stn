<!DOCTYPE html>
<html>
<head>
  <title>{{ title }} — {{ site_name }}</title>
  @style {
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; background: #f5f5f5; color: #222; }
    .container { max-width: 960px; margin: 0 auto; padding: 2rem; }
    header { background: #4f46e5; color: #fff; padding: 1.5rem 0; text-align: center; }
    header h1 { font-size: 2rem; }
    .card { background: #fff; border-radius: 8px; padding: 1.5rem; margin: 1.5rem 0; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    .card h2 { margin-bottom: .5rem; color: #4f46e5; }
    .card .meta { color: #666; font-size: .875rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
    .tag { display: inline-block; background: #eef2ff; color: #4f46e5; padding: .125rem .5rem; border-radius: 4px; font-size: .75rem; margin-right: .25rem; }
    .empty-state { text-align: center; padding: 3rem; }
    .empty-state h2 { color: #666; }
    footer { text-align: center; color: #666; font-size: .875rem; padding: 2rem 0; border-top: 1px solid #ddd; margin-top: 2rem; }
  }
</head>
<body>
  <header>
    <div class="container">
      <h1>{{ site_name }}</h1>
      <p>{{ tagline }}</p>
    </div>
  </header>

  <main class="container">
    @if (posts && posts.length > 0) {
      <div class="grid">
      @each (post in posts) {
        <article class="card">
          <h2>{{ post.title }}</h2>
          <p class="meta">
            {{ post.author | default("Staff") }}
            &middot;
            {{ post.date | date_format("MMM DD, YYYY") }}
          </p>
          <p>{{ post.excerpt | truncate(150) }}</p>
          @if (post.tags && post.tags.length > 0) {
            <p class="meta">
            @each (tag in post.tags) {
              <span class="tag">{{ tag }}</span>
            }
            </p>
          }
          <a href='/posts/{{ post.slug }}'>Read more &rarr;</a>
        </article>
      }
      </div>
    } @else {
      <div class="empty-state">
        <h2>Nothing here yet</h2>
        <p>Posts will appear once published.</p>
      </div>
    }
  </main>

  <footer class="container">
    <p>&copy; {{ year }} {{ site_name }}. Built with Stncil.</p>
  </footer>
</body>
</html>
