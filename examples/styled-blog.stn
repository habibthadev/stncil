<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Sora:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../apps/examples/shared/design.css" />

  <title>{{ title }} — {{ site_name }}</title>
  @style { .post-notes { padding-top: 1rem; border-top: 1px solid var(--line); margin-top: 1rem; } }
</head>
<body class="layout-narrow">
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header"><nav class="nav" aria-label="Example navigation"><a class="brand" href="hello.html"><span class="brand-sigil" aria-hidden="true">&#64;</span> stncil</a><span class="nav-divider" aria-hidden="true">/</span><span class="nav-current">Examples</span></nav></header>
  <main id="main" class="container" tabindex="-1">

  <div class="demo-heading">
    <div class="container">
      <h1>{{ site_name }}</h1>
      <p>{{ tagline }}</p>
    </div>
  </div>

  <section class="demo-section">
    @if (posts && posts.length > 0) {
      <div class="post-list">
      @each (post in posts) {
        <article class="post">
          <h2>{{ post.title }}</h2>
          <p class="meta">
            {{ post.author | default("Staff") }}
            &middot;
            {{ post.date | date_format("MMM DD, YYYY") }}
          </p>
          <p>{{ post.excerpt | truncate(150) }}</p>
          @if (post.tags && post.tags.length > 0) {
            <p class="meta post-notes">
            @each (tag in post.tags) {
              <span class="tag">{{ tag }}</span>
            }
            </p>
          }
          <a class="read-more" href='/posts/{{ post.slug | url_encode }}'>Read more &rarr;</a>
        </article>
      }
      </div>
    } @else {
      <div class="empty-state">
        <h2>Nothing here yet</h2>
        <p>Posts will appear once published.</p>
      </div>
    }
  </section>


  </main>
  <footer class="footer"><span>Made with stncil</span><span>Rendered from local sample data.</span></footer>
</body>
</html>
