<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Sora:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../apps/examples/shared/design.css" />

  <title>{{ page_title }}</title>
</head>
<body class="layout-narrow">
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header"><nav class="nav" aria-label="Example navigation"><a class="brand" href="hello.html"><span class="brand-sigil" aria-hidden="true">&#64;</span> stncil</a><span class="nav-divider" aria-hidden="true">/</span><span class="nav-current">Examples</span></nav></header>
  <main id="main" class="container" tabindex="-1">

  <h1>{{ page_title }}</h1>




  <section class="demo-section">
    <h2>Variables</h2>
    <p>Simple: {{ name }}</p>
    <p>Nested path: {{ user.profile.display_name }}</p>
    <p>With default: {{ bio | default("No bio provided.") }}</p>
  </section>




  <section class="demo-section">
    <h2>Filters</h2>
    <p>Uppercase: {{ name | upper }}</p>
    <p>Lowercase: {{ name | lower }}</p>
    <p>Truncated: {{ long_text | truncate(50) }}</p>
    <p>Joined list: {{ tags | join(", ") }}</p>
    <p>Chained: {{ name | lower | upper }}</p>
    <p>Date: {{ created_at | date_format("YYYY-MM-DD") }}</p>
  </section>




  <section class="demo-section">
    <h2>Conditionals</h2>

    @if (user.role == "admin") {
      <p class="admin-badge">Administrator</p>
    } @else if (user.role == "moderator") {
      <p class="mod-badge">Moderator</p>
    } @else {
      <p class="user-badge">Member</p>
    }

    @if (user.bio) {
      <blockquote>{{ user.bio }}</blockquote>
    }

    @if (user.score >= 100 && user.verified) {
      <p>Trusted contributor</p>
    }
  </section>




  <section class="demo-section">
    <h2>Let bindings</h2>

    @let full_name = user.first_name ~ " " ~ user.last_name
    <p>Full name: {{ full_name }}</p>

    @let discounted = price * (1 - discount_percent / 100)
    <p>Original: ${{ price }}</p>
    <p>Discounted: ${{ discounted }}</p>

    @let is_premium = user.score > 1000
    @if (is_premium) {
      <p class="premium">Premium member</p>
    }
  </section>




  <section class="demo-section">
    <h2>Loops</h2>

    <h3>Basic each loop</h3>
    <ul>
    @each (item in items) {
      <li>{{ item.name }}: {{ item.value }}</li>
    } @empty {
      <li>No items to display.</li>
    }
    </ul>

    <h3>Each loop with index</h3>
    <ol>
    @each (item, idx in items) {
      <li value='{{ idx + 1 }}'>{{ item.name }}</li>
    }
    </ol>
  </section>




  <section class="demo-section">
    <h2>Async data</h2>
    @async (comments from fetchComments(postId)) {
      <div class="comments">
      @each (comment in comments) {
        <div class="comment">
          <strong>{{ comment.author }}</strong>
          <p>{{ comment.body }}</p>
        </div>
      }
      </div>
    } @loading {
      <p>Loading comments...</p>
    } @error (err) {
      <p class="error">Error: {{ err.message }}</p>
    }
  </section>




  <section class="demo-section">
    <h2>Expressions</h2>

    @let result_a = 10 + 5 * 2
    @let result_b = (10 + 5) * 2
    @let result_c = 100 / items.length
    @let result_d = count % 2 == 0
    @let result_e = !is_deleted
    @let result_f = -temperature

    <p>a={{ result_a }}, b={{ result_b }}, c={{ result_c }}</p>
    <p>d={{ result_d }}, e={{ result_e }}, f={{ result_f }}</p>

    <h3>Ternary</h3>
    <p>Status: {{ user.is_active ? "active" : "inactive" }}</p>
  </section>




  <section class="demo-section">
    <h2>Escaping</h2>
    <p>{{ unsafe_html }}</p>
    <a href='/search?q={{ query | url_encode }}'>Search</a>
    <p>CSS value: <code>{{ color_value }}</code></p>
    <div>{{ unsafe_html }}</div>
  </section>
  </main>
  <footer class="footer"><span>Made with stncil</span><span>Rendered from local sample data.</span></footer>
</body>
</html>
