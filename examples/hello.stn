<!DOCTYPE html>
<html>
<head>
  <title>{{ title }}</title>
</head>
<body>
  <h1>Hello, {{ name | upper }}!</h1>
  <p>Welcome to {{ site_name }}.</p>

  {# This comment won't appear in output #}

  @if (show_greeting) {
    <p class="greeting">{{ greeting }}</p>
  } @else {
    <p>No greeting today.</p>
  }

  <footer>&copy; {{ year }} {{ site_name }}</footer>
</body>
</html>
