<!DOCTYPE html>
<html>
<head>
  <title>{{ title }}</title>
  @style {
    body { font-family: monospace; max-width: 600px; margin: 2rem auto; padding: 0 1rem; }
    h1 { color: #333; }
    form { background: #f9f9f9; padding: 1.5rem; border-radius: 8px; }
    label { display: block; margin: 1rem 0 .25rem; font-weight: 600; }
    input, textarea, select { width: 100%; padding: .5rem; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; }
    input:focus, textarea:focus { outline: 2px solid #4f46e5; outline-offset: -1px; }
    .error { color: #dc2626; font-size: .875rem; margin-top: .25rem; }
    .help-text { color: #666; font-size: .75rem; margin-top: .25rem; }
    button { background: #4f46e5; color: #fff; border: none; padding: .75rem 1.5rem; border-radius: 4px; font-size: 1rem; cursor: pointer; margin-top: 1rem; }
    button:hover { background: #4338ca; }
    .field-group { margin-bottom: 1rem; }
    .success { background: #dcfce7; color: #166534; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
    .error-summary { background: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
  }
</head>
<body>
  <h1>{{ title }}</h1>

  @if (flash_success) {
    <div class="success">{{ flash_success }}</div>
  }

  @if (errors && errors.length > 0) {
    <div class="error-summary">
      <strong>Please fix the following errors:</strong>
      <ul>
      @each (err in errors) {
        <li>{{ err.message }}</li>
      }
      </ul>
    </div>
  }

  <form method="POST" action='{{ action | default("/submit") }}'>
    @csrf

    <div class="field-group">
      <label for="name">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value='{{ form_data.name | default("") }}'
        @if (errors.name) { class="input-error" }
        required
      />
      @if (errors.name) {
        <p class="error">{{ errors.name }}</p>
      }
    </div>

    <div class="field-group">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        value='{{ form_data.email | default("") }}'
        required
      />
      @if (errors.email) {
        <p class="error">{{ errors.email }}</p>
      }
    </div>

    <div class="field-group">
      <label for="message">Message</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
      >{{ form_data.message | default("") }}</textarea>
      <p class="help-text">Max 1000 characters.</p>
      @if (errors.message) {
        <p class="error">{{ errors.message }}</p>
      }
    </div>

    <div class="field-group">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">Select a category</option>
      @each (cat in categories) {
        <option
          value='{{ cat.id }}'
          @if (form_data.category == cat.id) { selected }
        >{{ cat.name }}</option>
      }
      </select>
    </div>

    <button type="submit">Submit</button>
  </form>
</body>
</html>
