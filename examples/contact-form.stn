<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Sora:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../apps/examples/shared/design.css" />

  <title>{{ title }}</title>
</head>
<body class="layout-narrow">
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header"><nav class="nav" aria-label="Example navigation"><a class="brand" href="hello.html"><span class="brand-sigil" aria-hidden="true">&#64;</span> stncil</a><span class="nav-divider" aria-hidden="true">/</span><span class="nav-current">Examples</span></nav></header>
  <main id="main" class="container" tabindex="-1">

  <h1>{{ title }}</h1>

  @if (flash_success) {
    <div class="success">{{ flash_success }}</div>
  }

  @if (error_list && error_list.length > 0) {
    <div class="error-summary">
      <strong>Please fix the following errors:</strong>
      <ul>
      @each (err in error_list) {
        <li>{{ err.message }}</li>
      }
      </ul>
    </div>
  }

  <form method="POST" action='{{ action | default("/submit") | url }}'>
    @csrf

    <div class="field-group">
      <label for="name">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value='{{ form_data.name | default("") }}'
        @if (errors.name) { class="input-error" }
        required
      />
      @if (errors.name) {
        <p class="error">{{ errors.name }}</p>
      }
    </div>

    <div class="field-group">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        value='{{ form_data.email | default("") }}'
        required
      />
      @if (errors.email) {
        <p class="error">{{ errors.email }}</p>
      }
    </div>

    <div class="field-group">
      <label for="message">Message</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        maxlength="1000"
        required
      >{{ form_data.message | default("") }}</textarea>
      <p class="help-text">Max 1000 characters.</p>
      @if (errors.message) {
        <p class="error">{{ errors.message }}</p>
      }
    </div>

    <div class="field-group">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">Select a category</option>
      @each (cat in categories) {
        <option
          value='{{ cat.id }}'
          @if (form_data.category == cat.id) { selected }
        >{{ cat.name }}</option>
      }
      </select>
    </div>

    <button type="submit" class="btn btn-primary">Send message</button>
  </form>
  </main>
  <footer class="footer"><span>Made with stncil</span><span>Rendered from local sample data.</span></footer>
</body>
</html>
