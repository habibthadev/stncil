<!DOCTYPE html>
<html>
<head>
  <title>{{ title }}</title>
</head>
<body>
  <h1>{{ title }}</h1>

  @async (user from fetchUser(userId)) {
    <div class="user-profile">
      <h2>{{ user.name }}</h2>
      <p>Email: {{ user.email }}</p>
      <p>Joined: {{ user.created_at | date_format("YYYY-MM-DD") }}</p>
    </div>
  } @loading {
    <div class="loading">Loading user...</div>
  } @error (err) {
    <div class="error">Failed to load user: {{ err.message }}</div>
  }

  @async (posts from fetchPosts({ limit: 10, offset: 0 })) {
    <div class="posts">
    @each (post in posts) {
      <article>
        <h3><a href='{{ post.url }}'>{{ post.title }}</a></h3>
        <p>{{ post.body | truncate(300) }}</p>
      </article>
    }
    </div>
  } @loading {
    <p>Loading posts...</p>
  }

  <footer>
    <p>&copy; {{ year }} {{ site_name }}</p>
  </footer>
</body>
</html>
