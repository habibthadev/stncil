<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} / {{ site_name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Sora:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../apps/examples/shared/design.css" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-header"><nav class="nav" aria-label="Example navigation"><a class="brand" href="hello.html"><span class="brand-sigil" aria-hidden="true">&#64;</span> stncil</a><span class="nav-divider" aria-hidden="true">/</span><span class="nav-current">Examples</span></nav></header>
  <main id="main" class="container" tabindex="-1">
    @let greeting = user.hour < 12 ? "Good morning" : (user.hour < 18 ? "Good afternoon" : "Good evening")
    @let active_users = users | length
    <div class="dashboard">
      <aside class="sidebar"><h2>Your workspace</h2><nav aria-label="Dashboard sections"><a href="#overview" class="active">Overview</a><a href="#people">People</a><a href="#revenue">Revenue</a></nav></aside>
      <div class="dashboard-main" id="overview">
        <h1>{{ greeting }}, {{ user.name }}.</h1>
        <p class="subtitle">Here's what's happening {{ date | date_format("dddd, MMMM DD") }}.</p>
        <div class="stats">
          <div class="stat-card"><p class="label">Total users</p><p class="value">{{ stats.total_users }}</p><p class="label">+{{ stats.new_today }} today</p></div>
          <div class="stat-card"><p class="label">Active users</p><p class="value">{{ active_users }}</p><p class="label">{{ (stats.total_users > 0 ? active_users / stats.total_users * 100 : 0) | number_format(1) }}% of total</p></div>
          <div class="stat-card"><p class="label">Revenue</p><p class="value">${{ stats.revenue | number_format }}</p><p class="label">{{ stats.revenue_growth > 0 ? "+" : "" }}{{ stats.revenue_growth }}% vs last month</p></div>
          <div class="stat-card"><p class="label">Open tickets</p><p class="value">{{ stats.open_tickets }}</p><p class="label">{{ stats.tickets_resolved }} resolved today</p></div>
        </div>
        <section class="card" id="people">
          <div class="card-header"><h2>Recent users</h2></div>
          @if (recent_users && recent_users.length > 0) {
            <table class="people-table"><thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Joined</th></tr></thead><tbody>
              @each (person in recent_users) { <tr><td>{{ person.name }} @if (person.id == user.id) { <span class="badge">you</span> }</td><td>{{ person.email }}</td><td>{{ person.role | capitalize }}</td><td>{{ person.status | capitalize }}</td><td>{{ person.created_at | date_format("%b %d") }}</td></tr> }
            </tbody></table>
          } @else { <p class="hint">No recent users.</p> }
        </section>
        <section class="card" id="revenue">
          <div class="card-header"><h2>Daily revenue</h2><span class="hint">Sample totals</span></div>
          <div class="revenue-chart" role="img" aria-label="Daily revenue totals: {{ daily_revenue | join(', ') }}">
            @each (amount in daily_revenue) { <div class="chart-column"><div class="chart-bar" style="height: {{ amount > 0 ? (amount > 500 ? 100 : amount / 500 * 100) : 0 }}%"></div><span class="chart-value">{{ amount }}</span></div> }
          </div>
        </section>
      </div>
    </div>
  </main>
  <footer class="footer"><span>Made with stncil</span><span>Rendered from local sample data.</span></footer>
</body>
</html>
