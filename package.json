{
  "name": "stncil-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples:check": "pnpm build && node scripts/check-examples.mjs",
    "examples:http": "node scripts/check-http-examples.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/*/src",
    "format": "prettier --write packages/*/src/**/*.ts",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "prettier": "^3.0.0"
  }
}
